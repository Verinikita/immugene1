    }

  # Combinar los dos DataFrames
  combined_CountD_10 <- dplyr::bind_rows(CountG_10, CountD_10)

  # Reemplazar los valores NA con 0 en la columna richness_TRGD_CDR3aa
  combined_CountD_10[is.na(combined_CountD_10)] <- 0

  ###OTRA
  result_CountGD_10 <- combined_CountD_10 %>%
