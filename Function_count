fun_count<- function(data_list, column){

  #1FiltroIG de los datos completos
  data_TCR<- purrr::map(data_list, ~ tidyr::separate(.x,  allVHitsWithScore, c("allVHitsWithScore", "cloneIG"), sep = "IG"))
  df_TCR <- lapply(data_TCR, function(x) x[which(is.na(x[ ,("cloneIG")])==TRUE), ])
  data1<- purrr::map(df_TCR, ~ tidyr::separate(.x, allVHitsWithScore, c("allVHitsWithScore", "cloneTRA"), sep = "TRA"))
  data2<- purrr::map(data1,  ~ tidyr::separate(.x, allVHitsWithScore, c("allVHitsWithScore", "cloneTRB"), sep = "TRB"))
  data3<- purrr::map(data2,  ~ tidyr::separate(.x, allVHitsWithScore, c("allVHitsWithScore", "cloneTRG"), sep = "TRG"))
  data4<- purrr::map(data3,  ~ tidyr::separate(.x, allVHitsWithScore, c("allVHitsWithScore", "cloneTRD"), sep = "TRD"))

  #filtrar TRA TRB TRG TRD
  mA <- lapply(data4, function(x) x[which(is.na(x[,"cloneTRA"])==FALSE), ])
  mB <- lapply(data4, function(x) x[which(is.na(x[,"cloneTRB"])==FALSE), ])
  mG <- lapply(data4, function(x) x[which(is.na(x[,"cloneTRG"])==FALSE), ])
  mD <- lapply(data4, function(x) x[which(is.na(x[,"cloneTRD"])==FALSE), ])

  #####TRA
  if(column == "TRA.aa") {
    #Armar Dataframe para TRA
    data22<- NULL
    for(i in names(mA)){
      if (lengths(mA[[i]]["readFraction"]) >= 1 ) {
        data22[[i]] <- mA[[i]][,c("cloneTRA","readCount")]
        data22[[i]]["Proportions"]<-prop.table(mA[[i]]["readCount"])
        colnames(data22[[i]]) <-c("cloneTRA","readCount","Proportions")

      }else {
        data22[[i]]$cloneTRA <- 0
        data22[[i]]$readCount<-0
        data22[[i]]$Proportions <- 0
        data22[[i]]<- as.data.frame(data22[[i]])
      }
    }

    Count_10 <- data.frame()

    for (i in 1:length(data22)) {
      cumulative_sum <- 0
      read_count <- 0
      count_rows <- 0

      for (j in 1:nrow(data22[[i]])) {
        cumulative_sum <- cumulative_sum + data22[[i]][j, "Proportions"]
        read_count <- read_count + data22[[i]][j, "readCount"]
        count_rows <- count_rows + 1

        if (cumulative_sum >= 0.1) {

          break
        }
      }

      df_count <- data.frame(Sample = names(data22)[i], read_countTRA = read_count, ProportionsTRA = cumulative_sum, clones_10_TRA = count_rows)
      df_count <- cbind(df_count, readCount_10_TRA = ifelse(is.nan(df_count$read_countTRA * 0.1 / df_count$ProportionsTRA), 0, df_count$read_countTRA * 0.1 / df_count$ProportionsTRA))
      Count_10 <- rbind(Count_10, df_count)

    }

    return(Count_10)
  }

